<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Android" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Skia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup Label="Cryptography">
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>

  <ItemGroup Label="Dependency injection">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Desktop">
    <PackageVersion Include="FlashCap" Version="1.13.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup Label="Android">
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Core" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
