<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.Spikes.AndroidHead.Head.ViewModels"
             x:Class="P2PMessenger.Spikes.AndroidHead.Head.Views.SpikeView"
             x:DataType="vm:SpikeViewModel">
  <DockPanel Margin="8,36,8,8">
    <TextBlock DockPanel.Dock="Top" Text="Android head spike (S06)" FontSize="18" FontWeight="SemiBold" />
    <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
      <Button Content="Info" Command="{Binding ShowInfoCommand}" Margin="0,0,6,6" />
      <Button Content="Notifications" Command="{Binding NotificationsCommand}" Margin="0,0,6,6" />
      <Button Content="Camera permission" Command="{Binding CameraPermissionCommand}" Margin="0,0,6,6" />
      <Button Content="Battery exemption" Command="{Binding BatteryCommand}" Margin="0,0,6,6" />
      <Button Content="Start service" Command="{Binding StartServiceCommand}" Margin="0,0,6,6" />
      <Button Content="Stop service" Command="{Binding StopServiceCommand}" Margin="0,0,6,6" />
      <Button Content="Scan in view" Command="{Binding ToggleScannerCommand}" Margin="0,0,6,6" />
      <Button Content="Scan in activity" Command="{Binding ScanActivityCommand}" Margin="0,0,6,6" />
      <Button Content="Tor self-test" Command="{Binding TorSelfTestCommand}" Margin="0,0,6,6" />
      <Button Content="Tor pair" Command="{Binding TorPairCommand}" Margin="0,0,6,6" />
      <Button Content="Tor serve" Command="{Binding TorServeCommand}" Margin="0,0,6,6" />
      <Button Content="Stop tor" Command="{Binding TorStopCommand}" Margin="0,0,6,6" />
      <Button Content="Copy log" Command="{Binding CopyLogCommand}" Margin="0,0,6,6" />
    </WrapPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
      <CheckBox Content="Wake lock" IsChecked="{Binding UseWakeLock}" />
      <TextBox Text="{Binding Port}" Width="90" PlaceholderText="Port" />
      <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" Height="260" Margin="0,6,0,0" IsVisible="{Binding IsScannerVisible}">
      <Border x:Name="ScannerFrame" Background="#202020" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="10,4" Background="#C0000000" IsHitTestVisible="False">
        <TextBlock Text="Avalonia label over the camera view" Foreground="White" />
      </Border>
    </Grid>
    <ScrollViewer x:Name="LogScroll" Margin="0,6,0,0">
      <SelectableTextBlock Text="{Binding Log}" FontFamily="monospace" FontSize="10" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
