<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RootNamespace>P2PMessenger.Spikes.AndroidHead.Head</RootNamespace>
    <ApplicationId>io.github.kaunazdagaz.p2pmessenger.androidheadspike</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <TorBundle>$(MSBuildThisFileDirectory)..\tor-bundles\16.0\</TorBundle>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Tor\P2PMessenger.Spikes.Tor.Cli\*.cs" LinkBase="Tor\Cli" />
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="$(TorBundle)android-aarch64\tor\libTor.so" Abi="arm64-v8a" Condition="Exists('$(TorBundle)android-aarch64\tor\libTor.so')" />
    <AndroidNativeLibrary Include="$(TorBundle)android-x86_64\tor\libTor.so" Abi="x86_64" Condition="Exists('$(TorBundle)android-x86_64\tor\libTor.so')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\P2PMessenger.Spikes.AndroidHead\P2PMessenger.Spikes.AndroidHead.csproj" />
    <ProjectReference Include="..\Tor\P2PMessenger.Spikes.Tor\P2PMessenger.Spikes.Tor.csproj" />
  </ItemGroup>

  <Target Name="CheckTorBundle" BeforeTargets="BeforeBuild" Condition="!Exists('$(TorBundle)android-aarch64\tor\libTor.so')">
    <Error Text="The Android tor binary is missing. Run: powershell -ExecutionPolicy Bypass -File spikes\AndroidHead\get-tor.ps1 -Platform android-aarch64,android-x86_64" />
  </Target>
</Project>
