<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="P2PMessenger.UI.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml" />
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2F5BEA" RegionColor="#FFFFFF" ErrorText="#B42318" />
                <ColorPaletteResources x:Key="Dark" Accent="#3B66F0" RegionColor="#171E29" ErrorText="#FF9A90" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/Typography.axaml" />
        <StyleInclude Source="/Styles/Controls.axaml" />
        <StyleInclude Source="/Styles/Surfaces.axaml" />
        <StyleInclude Source="/Styles/Components.axaml" />
    </Application.Styles>
</Application>
