<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.NewGroupView"
             x:DataType="vm:NewGroupViewModel">
    <c:PageContainer>
        <StackPanel Spacing="16">
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <c:FormField Label="{x:Static res:UiText.NewGroupNameLabel}">
                        <TextBox x:Name="NameBox"
                                 Text="{Binding Name}"
                                 PlaceholderText="{x:Static res:UiText.NewGroupNamePlaceholder}"
                                 AutomationProperties.Name="{x:Static res:UiText.NewGroupNameLabel}" />
                    </c:FormField>
                    <TextBlock Classes="label" Text="{x:Static res:UiText.NewGroupMembersLabel}" />
                    <TextBlock x:Name="NoContactsText"
                               Classes="muted"
                               Text="{x:Static res:UiText.NewGroupNoContacts}"
                               IsVisible="{Binding HasNoContacts}" />
                    <ItemsControl x:Name="CandidateItems" ItemsSource="{Binding Candidates}" IsVisible="{Binding HasContacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GroupCandidateViewModel">
                                <CheckBox Margin="0,0,0,8" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel>
                                        <c:Avatar DockPanel.Dock="Left"
                                                  Size="36"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  DisplayName="{Binding Name}" />
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Classes="label" Text="{Binding Name}" />
                                            <TextBlock Classes="caption mono" Text="{Binding Fingerprint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Button x:Name="CreateButton"
                    Classes="primary iconic"
                    c:Icons.Glyph="{StaticResource IconUsers}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static res:UiText.NewGroupCreate}"
                    Command="{Binding CreateCommand}" />
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                <TextBlock x:Name="ErrorText"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </c:PageContainer>
</UserControl>
