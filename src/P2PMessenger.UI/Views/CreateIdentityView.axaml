<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             x:Class="P2PMessenger.UI.Views.CreateIdentityView"
             x:DataType="vm:CreateIdentityViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Static res:UiText.CreateIdentityIntro}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:UiText.CreateIdentityNameLabel}" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox"
                     Text="{Binding Name}"
                     PlaceholderText="{x:Static res:UiText.CreateIdentityNamePlaceholder}"
                     AutomationProperties.Name="{x:Static res:UiText.CreateIdentityNameLabel}" />
            <Button x:Name="CreateButton"
                    Content="{x:Static res:UiText.CreateIdentityCreate}"
                    Command="{Binding CreateCommand}"
                    IsDefault="True" />
            <TextBlock x:Name="BusyText" Text="{x:Static res:UiText.CreateIdentityCreating}" IsVisible="{Binding IsBusy}" />
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
