<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             x:Class="P2PMessenger.UI.Views.CreateIdentityView"
             x:DataType="vm:CreateIdentityViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Static res:UiText.CreateIdentityIntro}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:UiText.CreateIdentityNameLabel}" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox"
                     Text="{Binding Name}"
                     PlaceholderText="{x:Static res:UiText.CreateIdentityNamePlaceholder}"
                     AutomationProperties.Name="{x:Static res:UiText.CreateIdentityNameLabel}" />
            <StackPanel x:Name="PassphrasePanel" Spacing="8" IsVisible="{Binding OffersPassphrase}">
                <TextBlock Text="{x:Static res:UiText.CreateIdentityPassphraseLabel}" FontWeight="SemiBold" />
                <TextBox x:Name="PassphraseBox"
                         Text="{Binding Passphrase}"
                         PasswordChar="•"
                         AutomationProperties.Name="{x:Static res:UiText.CreateIdentityPassphraseLabel}" />
                <TextBlock Text="{x:Static res:UiText.PassphraseRepeatLabel}" FontWeight="SemiBold" />
                <TextBox x:Name="RepeatBox"
                         Text="{Binding RepeatedPassphrase}"
                         PasswordChar="•"
                         AutomationProperties.Name="{x:Static res:UiText.PassphraseRepeatLabel}" />
                <TextBlock x:Name="HintText" Text="{x:Static vm:CreateIdentityViewModel.Hint}" TextWrapping="Wrap" />
                <TextBlock x:Name="SkipWarningText" Text="{Binding SkipWarning}" TextWrapping="Wrap" IsVisible="{Binding IsSkippingPassphrase}" />
            </StackPanel>
            <StackPanel x:Name="TorPanel" Spacing="4" IsVisible="{Binding OffersTor}">
                <CheckBox x:Name="UseTorCheckBox"
                          IsChecked="{Binding UseTor}"
                          Content="{x:Static res:UiText.CreateIdentityUseTor}" />
                <TextBlock x:Name="UseTorHintText" Text="{x:Static res:UiText.CreateIdentityUseTorHint}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CreateButton"
                    Content="{x:Static res:UiText.CreateIdentityCreate}"
                    Command="{Binding CreateCommand}"
                    IsDefault="True" />
            <TextBlock x:Name="BusyText" Text="{x:Static res:UiText.CreateIdentityCreating}" IsVisible="{Binding IsBusy}" />
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
