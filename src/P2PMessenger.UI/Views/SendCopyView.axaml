<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.SendCopyView"
             x:DataType="vm:SendCopyViewModel">
    <c:PageContainer>
        <StackPanel Spacing="16">
            <StackPanel x:Name="PairingPanel" Spacing="8" IsVisible="{Binding IsPairingVisible}">
                <Button x:Name="ScanButton"
                        Classes="primary iconic"
                        c:Icons.Glyph="{StaticResource IconQr}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:UiText.SendCopyScan}"
                        Command="{Binding ScanCommand}" />
            </StackPanel>
            <Border Classes="card" IsVisible="{Binding IsSelectingVisible}">
                <StackPanel x:Name="SelectingPanel" Spacing="12" IsVisible="{Binding IsSelectingVisible}">
                    <TextBlock Classes="heading" Text="{x:Static res:UiText.SendCopyChatsLabel}" />
                    <TextBlock x:Name="NoChatsText"
                               Classes="muted"
                               Text="{x:Static res:UiText.SendCopyNoChats}"
                               IsVisible="{Binding HasNoCandidates}" />
                    <ItemsControl x:Name="CandidateItems" ItemsSource="{Binding Candidates}" IsVisible="{Binding HasCandidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CopyCandidateViewModel">
                                <CheckBox Margin="0,0,0,8" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}">
                                    <DockPanel>
                                        <c:Avatar DockPanel.Dock="Left"
                                                  Size="36"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  DisplayName="{Binding Title}" />
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Classes="label" Text="{Binding Title}" />
                                            <TextBlock Classes="caption" Text="{Binding DetailText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Classes="actions">
                        <Button x:Name="CopySelectedButton"
                                Classes="primary iconic"
                                c:Icons.Glyph="{StaticResource IconUpload}"
                                Content="{x:Static res:UiText.SendCopyStart}"
                                Command="{Binding CopySelectedCommand}" />
                        <Button x:Name="DisconnectButton"
                                Content="{x:Static res:UiText.SendCopyDisconnect}"
                                Command="{Binding DisconnectCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <Border x:Name="StatusPanel" Classes="notice success" IsVisible="{Binding HasStatus}">
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                <TextBlock x:Name="ErrorText"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
            </Border>
            <Button x:Name="DoneButton"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static res:UiText.SendCopyDone}"
                    Command="{Binding DoneCommand}"
                    IsVisible="{Binding IsCompleted}" />
        </StackPanel>
    </c:PageContainer>
</UserControl>
