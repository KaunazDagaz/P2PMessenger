<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.CopiedConversationView"
             x:DataType="vm:CopiedConversationViewModel">
    <Grid>
        <Border Classes="chat">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="card flat" Padding="14,12,14,4" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                        <Border x:Name="ReadOnlyPanel" Classes="notice plain">
                            <DockPanel>
                                <c:Icon DockPanel.Dock="Left"
                                        Classes="muted"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        Data="{StaticResource IconLock}" />
                                <TextBlock x:Name="ReadOnlyText" Text="{Binding BannerText}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <WrapPanel Classes="actions">
                            <Button x:Name="DeleteCopyButton"
                                    Classes="quiet danger iconic"
                                    c:Icons.Glyph="{StaticResource IconTrash}"
                                    Content="{x:Static res:UiText.CopiedConversationDelete}"
                                    Command="{Binding AskDeleteCopyCommand}"
                                    IsVisible="{Binding IsDeleteCopyVisible}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Classes="notice danger" Margin="0,0,0,10" IsVisible="{Binding #ErrorText.IsVisible}">
                    <TextBlock x:Name="ErrorText"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                </Border>
                <Grid>
                    <TextBlock x:Name="EmptyText"
                               Classes="muted centered"
                               Text="{x:Static res:UiText.CopiedConversationEmpty}"
                               IsVisible="{Binding IsEmpty}"
                               VerticalAlignment="Center" />
                    <ScrollViewer>
                        <ItemsControl x:Name="MessageItems" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CopiedMessageItemViewModel">
                                    <Border Classes="bubble"
                                            Classes.own="{Binding IsOwn}"
                                            Classes.theirs="{Binding IsTheirs}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding Sender}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding WrittenAt}" />
                                            </TextBlock>
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <c:Dialog IsOpen="{Binding IsConfirmingDeleteCopy}" CancelCommand="{Binding CancelDeleteCopyCommand}">
            <Border x:Name="DeleteCopyPanel" IsVisible="{Binding IsConfirmingDeleteCopy}">
                <StackPanel Spacing="14">
                    <c:DialogHeader Classes="danger"
                                    Glyph="{StaticResource IconTrash}"
                                    Title="{x:Static res:UiText.CopiedConversationDelete}" />
                    <TextBlock x:Name="DeleteCopyQuestionText" Text="{Binding DeleteCopyQuestion}" TextWrapping="Wrap" />
                    <TextBlock Classes="error"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="DeleteCopyBusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsDeletingCopy}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <StackPanel Classes="dialogActions">
                        <Button x:Name="DeleteCopyCancelButton"
                                Content="{x:Static res:UiText.CommonCancel}"
                                Command="{Binding CancelDeleteCopyCommand}" />
                        <Button x:Name="DeleteCopyConfirmButton"
                                Classes="danger iconic"
                                c:Icons.Glyph="{StaticResource IconTrash}"
                                Content="{x:Static res:UiText.CommonDelete}"
                                Command="{Binding DeleteCopyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </c:Dialog>
    </Grid>
</UserControl>
