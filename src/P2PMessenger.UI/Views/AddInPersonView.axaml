<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.AddInPersonView"
             x:DataType="vm:AddInPersonViewModel">
    <c:PageContainer>
        <StackPanel Spacing="16">
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Border Classes="qr">
                        <c:QrCodeView x:Name="QrCode"
                                      Matrix="{Binding QrCode}"
                                      HorizontalAlignment="Center"
                                      AutomationProperties.Name="{x:Static res:UiText.InPersonQrLabel}" />
                    </Border>
                    <TextBlock x:Name="NameText" Classes="title centered" Text="{Binding Name}" />
                    <TextBlock x:Name="FingerprintText" Classes="caption mono centered" Text="{Binding Fingerprint}" />
                    <Button x:Name="ScanButton"
                            Classes="primary iconic"
                            c:Icons.Glyph="{StaticResource IconQr}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,6,0,0"
                            Content="{x:Static res:UiText.InPersonScan}"
                            Command="{Binding ScanCommand}" />
                    <ProgressBar x:Name="BusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                        <TextBlock x:Name="ErrorText"
                                   Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="AddByCodeButton"
                            Classes="quiet"
                            HorizontalAlignment="Center"
                            Content="{x:Static res:UiText.InPersonAddByCode}"
                            Command="{Binding AddByCodeCommand}"
                            IsVisible="{Binding OffersTextCodes}" />
                </StackPanel>
            </Border>
            <Border x:Name="StatusPanel" Classes="notice success" IsVisible="{Binding HasStatus}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{x:Static res:UiText.AddContactFingerprintLabel}" IsVisible="{Binding HasScannedContact}" />
                    <SelectableTextBlock x:Name="ScannedFingerprintText"
                                         Classes="mono"
                                         TextWrapping="Wrap"
                                         Text="{Binding ScannedFingerprint}"
                                         IsVisible="{Binding HasScannedContact}" />
                    <Button x:Name="OpenChatButton"
                            Classes="primary iconic"
                            c:Icons.Glyph="{StaticResource IconMessage}"
                            HorizontalAlignment="Left"
                            Content="{x:Static res:UiText.InPersonOpenChat}"
                            Command="{Binding OpenChatCommand}"
                            IsVisible="{Binding IsConnected}" />
                </StackPanel>
            </Border>
            <Border x:Name="PreviewPanel" Classes="card" IsVisible="{Binding HasPreview}">
                <StackPanel Spacing="12">
                    <DockPanel>
                        <c:Avatar DockPanel.Dock="Left"
                                  Size="52"
                                  Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  DisplayName="{Binding PreviewName}" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="caption" Text="{x:Static res:UiText.AddContactNameLabel}" />
                            <TextBlock x:Name="PreviewName" Classes="title" Text="{Binding PreviewName}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Classes="caption" Text="{x:Static res:UiText.AddContactFingerprintLabel}" />
                    <Border Classes="fingerprint">
                        <SelectableTextBlock x:Name="PreviewFingerprint"
                                             Classes="mono"
                                             TextWrapping="Wrap"
                                             Text="{Binding PreviewFingerprint}" />
                    </Border>
                    <TextBlock x:Name="PreviewHint" Classes="muted" Text="{Binding PreviewHint}" />
                    <Button x:Name="AddButton"
                            Classes="primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{Binding AddText}"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </c:PageContainer>
</UserControl>
