<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:v="using:P2PMessenger.UI.Views"
             x:Class="P2PMessenger.UI.Views.DeleteAllDataPageView"
             x:DataType="vm:DeleteAllDataPageViewModel">
    <ScrollViewer>
        <v:DeleteAllDataPanel x:Name="DeleteAllPanel" Margin="16" MaxWidth="560" HorizontalAlignment="Stretch" DataContext="{Binding Panel}" />
    </ScrollViewer>
</UserControl>
