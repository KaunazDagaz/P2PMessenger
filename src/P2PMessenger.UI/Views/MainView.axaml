<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:v="using:P2PMessenger.UI.Views"
             x:Class="P2PMessenger.UI.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:StorageProblemViewModel">
            <v:StorageProblemView />
        </DataTemplate>
        <DataTemplate DataType="vm:CreateIdentityViewModel">
            <v:CreateIdentityView />
        </DataTemplate>
        <DataTemplate DataType="vm:ContactListViewModel">
            <v:ContactListView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel">
            <v:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddContactViewModel">
            <v:AddContactView />
        </DataTemplate>
        <DataTemplate DataType="vm:AddInPersonViewModel">
            <v:AddInPersonView />
        </DataTemplate>
        <DataTemplate DataType="vm:ConversationViewModel">
            <v:ConversationView />
        </DataTemplate>
        <DataTemplate DataType="vm:VerifyContactViewModel">
            <v:VerifyContactView />
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkViewModel">
            <v:NetworkView />
        </DataTemplate>
        <DataTemplate DataType="vm:UnlockViewModel">
            <v:UnlockView />
        </DataTemplate>
        <DataTemplate DataType="vm:PassphraseViewModel">
            <v:PassphraseView />
        </DataTemplate>
        <DataTemplate DataType="vm:DeleteAllDataPageViewModel">
            <v:DeleteAllDataPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:BackgroundViewModel">
            <v:BackgroundView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <Button x:Name="BackButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0"
                        Content="{x:Static res:UiText.CommonBack}"
                        Command="{Binding GoBackCommand}"
                        IsVisible="{Binding IsBackVisible}" />
                <Button x:Name="LockButton"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Content="{x:Static res:UiText.LockNow}"
                        Command="{Binding LockCommand}"
                        IsVisible="{Binding CanLock}" />
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border x:Name="NoticePanel"
                DockPanel.Dock="Top"
                Margin="12,12,12,0"
                Padding="12"
                BorderThickness="1"
                CornerRadius="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                IsVisible="{Binding HasNotice}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Content="{x:Static res:UiText.CommonDismiss}"
                        Command="{Binding DismissNoticeCommand}" />
                <TextBlock x:Name="NoticeText" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock x:Name="StartingText"
                       Text="{x:Static res:UiText.AppStarting}"
                       IsVisible="{Binding IsStarting}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap"
                       Margin="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" IsVisible="{Binding IsPageVisible}" />
            <ContentControl x:Name="LockHost" Content="{Binding LockPage}" IsVisible="{Binding IsLocked}" />
        </Grid>
    </DockPanel>
</UserControl>
