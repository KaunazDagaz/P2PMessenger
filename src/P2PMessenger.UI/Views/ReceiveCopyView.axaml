<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.ReceiveCopyView"
             x:DataType="vm:ReceiveCopyViewModel">
    <c:PageContainer>
        <StackPanel Spacing="16">
            <Border Classes="card" IsVisible="{Binding HasQrCode}">
                <StackPanel x:Name="QrPanel" Spacing="8" IsVisible="{Binding HasQrCode}">
                    <Border Classes="qr">
                        <c:QrCodeView x:Name="QrCode"
                                      Matrix="{Binding QrCode}"
                                      HorizontalAlignment="Center"
                                      AutomationProperties.Name="{x:Static res:UiText.ReceiveCopyQrLabel}" />
                    </Border>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <Border x:Name="StatusPanel" Classes="notice success" IsVisible="{Binding HasStatus}">
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                <TextBlock x:Name="ErrorText"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" />
            </Border>
            <WrapPanel Classes="actions">
                <Button x:Name="RetryButton"
                        Content="{Binding RetryButtonText}"
                        Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanShowRetry}" />
                <Button x:Name="DoneButton"
                        Classes="primary"
                        Content="{x:Static res:UiText.ReceiveCopyDone}"
                        Command="{Binding DoneCommand}"
                        IsVisible="{Binding IsCompleted}" />
            </WrapPanel>
        </StackPanel>
    </c:PageContainer>
</UserControl>
