<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.GroupConversationView"
             x:DataType="vm:GroupConversationViewModel">
    <Grid>
        <Border Classes="chat">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="card flat" Padding="14,12,14,4" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <c:Avatar DockPanel.Dock="Left"
                                      Size="44"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      DisplayName="{Binding Title}" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MembersText" Classes="label" Text="{Binding MembersText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CreatedByText" Classes="caption" Text="{Binding CreatedByText}" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Classes="actions">
                            <Button x:Name="MembersButton"
                                    Classes="quiet iconic"
                                    c:Icons.Glyph="{StaticResource IconUsers}"
                                    Content="{Binding MembersButtonText}"
                                    Command="{Binding ToggleMembersCommand}" />
                            <Button x:Name="DeleteChatButton"
                                    Classes="quiet danger iconic"
                                    c:Icons.Glyph="{StaticResource IconTrash}"
                                    Content="{x:Static res:UiText.ConversationDeleteChat}"
                                    Command="{Binding AskDeleteChatCommand}"
                                    IsVisible="{Binding IsDeleteChatVisible}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="EndedOrLeftPanel"
                        DockPanel.Dock="Top"
                        Classes="notice plain"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasEndedOrLeftText}">
                    <TextBlock x:Name="EndedOrLeftText" Text="{Binding EndedOrLeftText}" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="JoiningPanel"
                        DockPanel.Dock="Top"
                        Classes="notice warning"
                        Margin="0,0,0,10"
                        IsVisible="{Binding IsJoining}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="JoiningText" Text="{x:Static res:UiText.GroupJoiningIntro}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="MembersToAddItems" ItemsSource="{Binding MembersToAdd}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GroupMemberToAddViewModel">
                                    <StackPanel Margin="0,0,0,6" Spacing="2">
                                        <TextBlock Classes="label" Text="{Binding Name}" />
                                        <TextBlock Classes="caption mono" Text="{Binding Fingerprint}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NothingToAddText"
                                   Text="{x:Static res:UiText.GroupJoiningNone}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasNothingToAdd}" />
                    </StackPanel>
                </Border>
                <Border x:Name="WaitingPanel"
                        DockPanel.Dock="Top"
                        Classes="notice warning"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasWaitingText}">
                    <TextBlock x:Name="WaitingText" Text="{Binding WaitingText}" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="ListsDifferPanel"
                        DockPanel.Dock="Top"
                        Classes="notice danger"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasListsDifferText}">
                    <TextBlock x:Name="ListsDifferText" Text="{Binding ListsDifferText}" TextWrapping="Wrap" />
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <ProgressBar x:Name="BusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                        <TextBlock x:Name="ErrorText"
                                   Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <DockPanel IsVisible="{Binding CanWrite}">
                        <Button x:Name="SendButton"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Classes="primary iconic"
                                c:Icons.Glyph="{StaticResource IconSend}"
                                Content="{x:Static res:UiText.ConversationSend}"
                                Command="{Binding SendCommand}" />
                        <TextBox x:Name="DraftBox"
                                 Text="{Binding Draft}"
                                 PlaceholderText="{x:Static res:UiText.ConversationMessagePlaceholder}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="160"
                                 AutomationProperties.Name="{x:Static res:UiText.ConversationMessagePlaceholder}"
                                 c:SendOnEnter.Command="{Binding SendCommand}" />
                    </DockPanel>
                </StackPanel>
                <Grid>
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}">
                        <Border Classes="heroIcon">
                            <c:Icon Classes="accent"
                                    Size="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource IconUsers}" />
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Classes="muted centered"
                                   Text="{x:Static res:UiText.ConversationEmpty}"
                                   IsVisible="{Binding IsEmpty}" />
                    </StackPanel>
                    <ScrollViewer c:StickToBottom.IsEnabled="True">
                        <ItemsControl x:Name="MessageItems" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GroupMessageItemViewModel">
                                    <Border Classes="bubble"
                                            Classes.own="{Binding IsOwn}"
                                            Classes.theirs="{Binding IsTheirs}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding Sender}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding WrittenAt}" />
                                            </TextBlock>
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <Button Name="DeliveryStateButton"
                                                    HorizontalAlignment="Right"
                                                    Classes="quiet"
                                                    Content="{Binding StateText}"
                                                    Command="{Binding ToggleDetailsCommand}"
                                                    IsVisible="{Binding IsOwn}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <c:Dialog IsOpen="{Binding IsMembersShown}" CardMaxWidth="520" CancelCommand="{Binding ToggleMembersCommand}">
            <Border x:Name="MembersPanel" IsVisible="{Binding IsMembersShown}">
                <StackPanel Spacing="14">
                    <c:DialogHeader Glyph="{StaticResource IconUsers}" Title="{Binding MembersButtonText}" />
                    <ItemsControl x:Name="MembersItems" ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GroupMemberItemViewModel">
                                <DockPanel Margin="0,0,0,10">
                                    <Button Name="RemoveMemberButton"
                                            DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Classes="quiet danger"
                                            Content="{x:Static res:UiText.GroupRemoveMember}"
                                            Command="{Binding AskRemoveCommand}"
                                            IsVisible="{Binding IsRemoveButtonVisible}" />
                                    <c:Avatar DockPanel.Dock="Left"
                                              Size="38"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              DisplayName="{Binding Name}" />
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="label" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            <Border Classes="pill accent" VerticalAlignment="Center" IsVisible="{Binding IsAdmin}">
                                                <TextBlock Classes="caption" Text="{x:Static res:UiText.GroupMemberAdmin}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="caption mono" Text="{Binding Fingerprint}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="error"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                    <StackPanel Classes="dialogActions">
                        <Button x:Name="LeaveGroupButton"
                                Classes="quiet danger iconic"
                                c:Icons.Glyph="{StaticResource IconClose}"
                                Content="{x:Static res:UiText.GroupLeave}"
                                Command="{Binding AskLeaveCommand}"
                                IsVisible="{Binding IsLeaveVisible}" />
                        <Button x:Name="MembersCloseButton"
                                Content="{x:Static res:UiText.CommonClose}"
                                Command="{Binding ToggleMembersCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding HasDetailsMessage}" CancelCommand="{Binding DetailsMessage.ToggleDetailsCommand}">
            <StackPanel x:Name="DeliveryDetailsPanel"
                        DataContext="{Binding DetailsMessage}"
                        x:DataType="vm:GroupMessageItemViewModel"
                        Spacing="14">
                <c:DialogHeader Glyph="{StaticResource IconMessage}" Title="{Binding StateText}" />
                <ItemsControl x:Name="DeliveryMemberItems" ItemsSource="{Binding MemberDeliveries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GroupDeliveryMemberViewModel">
                            <TextBlock Margin="0,0,0,4" Text="{Binding SummaryText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Classes="dialogActions">
                    <Button x:Name="DeleteMessageButton"
                            Classes="quiet danger iconic"
                            c:Icons.Glyph="{StaticResource IconTrash}"
                            Content="{x:Static res:UiText.MessageDelete}"
                            Command="{Binding AskDeleteCommand}"
                            IsVisible="{Binding IsDeleteVisible}" />
                    <Button x:Name="DeliveryDetailsCloseButton"
                            Content="{x:Static res:UiText.CommonClose}"
                            Command="{Binding ToggleDetailsCommand}" />
                </StackPanel>
            </StackPanel>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding IsConfirmingDeleteChat}" CancelCommand="{Binding CancelDeleteChatCommand}">
            <Border x:Name="DeleteChatPanel" IsVisible="{Binding IsConfirmingDeleteChat}">
                <StackPanel Spacing="14">
                    <c:DialogHeader Classes="danger"
                                    Glyph="{StaticResource IconTrash}"
                                    Title="{x:Static res:UiText.ConversationDeleteChat}" />
                    <TextBlock x:Name="DeleteChatQuestionText" Text="{Binding DeleteChatQuestion}" TextWrapping="Wrap" />
                    <TextBlock Classes="error"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="DeleteChatBusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsDeletingChat}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <StackPanel Classes="dialogActions">
                        <Button x:Name="DeleteChatCancelButton"
                                Content="{x:Static res:UiText.CommonCancel}"
                                Command="{Binding CancelDeleteChatCommand}" />
                        <Button x:Name="DeleteChatConfirmButton"
                                Classes="danger iconic"
                                c:Icons.Glyph="{StaticResource IconTrash}"
                                Content="{x:Static res:UiText.CommonDelete}"
                                Command="{Binding DeleteChatCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding IsConfirmingLeave}" CancelCommand="{Binding CancelLeaveCommand}">
            <Border x:Name="LeaveGroupPanel" IsVisible="{Binding IsConfirmingLeave}">
                <StackPanel Spacing="14">
                    <c:DialogHeader Classes="danger"
                                    Glyph="{StaticResource IconClose}"
                                    Title="{x:Static res:UiText.GroupLeave}" />
                    <TextBlock x:Name="LeaveGroupQuestionText" Text="{Binding LeaveQuestion}" TextWrapping="Wrap" />
                    <StackPanel Spacing="4" IsVisible="{Binding NeedsSuccessor}">
                        <TextBlock Classes="caption" Text="{x:Static res:UiText.GroupLeaveSuccessorLabel}" />
                        <ComboBox x:Name="SuccessorPicker"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SuccessorCandidates}"
                                  SelectedItem="{Binding SelectedSuccessor}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:GroupSuccessorOptionViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Classes="error"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="LeaveGroupBusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsLeaving}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <StackPanel Classes="dialogActions">
                        <Button x:Name="LeaveGroupCancelButton"
                                Content="{x:Static res:UiText.CommonCancel}"
                                Command="{Binding CancelLeaveCommand}" />
                        <Button x:Name="LeaveGroupConfirmButton"
                                Classes="danger"
                                Content="{x:Static res:UiText.GroupLeaveConfirm}"
                                Command="{Binding LeaveGroupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding HasRemovingMember}" CancelCommand="{Binding RemovingMember.CancelRemoveCommand}">
            <StackPanel x:Name="RemoveMemberPanel"
                        DataContext="{Binding RemovingMember}"
                        x:DataType="vm:GroupMemberItemViewModel"
                        Spacing="14">
                <c:DialogHeader Classes="danger"
                                Glyph="{StaticResource IconClose}"
                                Title="{x:Static res:UiText.GroupRemoveMemberTitle}" />
                <TextBlock x:Name="RemoveMemberQuestionText" Text="{Binding RemoveQuestion}" TextWrapping="Wrap" />
                <ProgressBar x:Name="RemoveMemberBusyBar"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRemoving}"
                             AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                <StackPanel Classes="dialogActions">
                    <Button x:Name="RemoveMemberCancelButton"
                            Content="{x:Static res:UiText.CommonCancel}"
                            Command="{Binding CancelRemoveCommand}" />
                    <Button x:Name="RemoveMemberConfirmButton"
                            Classes="danger"
                            Content="{x:Static res:UiText.GroupRemoveMember}"
                            Command="{Binding ConfirmRemoveCommand}" />
                </StackPanel>
            </StackPanel>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding HasDeletingMessage}" CancelCommand="{Binding DeletingMessage.CancelDeleteCommand}">
            <StackPanel x:Name="DeleteMessagePanel"
                        DataContext="{Binding DeletingMessage}"
                        x:DataType="vm:GroupMessageItemViewModel"
                        Spacing="14">
                <c:DialogHeader Classes="danger"
                                Glyph="{StaticResource IconTrash}"
                                Title="{x:Static res:UiText.MessageDelete}" />
                <TextBlock x:Name="DeleteMessageQuestionText"
                           Text="{x:Static res:UiText.GroupMessageDeleteQuestion}"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="DeleteMessageBusyBar"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsDeleting}"
                             AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                <StackPanel Classes="dialogActions">
                    <Button x:Name="DeleteMessageCancelButton"
                            Content="{x:Static res:UiText.CommonCancel}"
                            Command="{Binding CancelDeleteCommand}" />
                    <Button x:Name="DeleteMessageConfirmButton"
                            Classes="danger iconic"
                            c:Icons.Glyph="{StaticResource IconTrash}"
                            Content="{x:Static res:UiText.CommonDelete}"
                            Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </c:Dialog>
    </Grid>
</UserControl>
