<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:c="using:P2PMessenger.UI.Controls"
             x:Class="P2PMessenger.UI.Views.ConversationView"
             x:DataType="vm:ConversationViewModel">
    <Grid>
        <Border Classes="chat">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="card flat" Padding="14,12,14,4" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <c:Avatar DockPanel.Dock="Left"
                                      Size="44"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      DisplayName="{Binding ContactName}" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" Classes="label" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FingerprintText" Classes="caption mono" Text="{Binding Fingerprint}" />
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Classes="actions">
                            <Button x:Name="DetailsButton"
                                    Classes="quiet iconic"
                                    c:Icons.Glyph="{StaticResource IconShieldCheck}"
                                    Content="{x:Static res:UiText.ConversationDetails}"
                                    Command="{Binding CompareCommand}" />
                            <Button x:Name="DeleteChatButton"
                                    Classes="quiet danger iconic"
                                    c:Icons.Glyph="{StaticResource IconTrash}"
                                    Content="{x:Static res:UiText.ConversationDeleteChat}"
                                    Command="{Binding AskDeleteChatCommand}"
                                    IsVisible="{Binding IsDeleteChatVisible}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="WaitingPanel"
                        DockPanel.Dock="Top"
                        Classes="notice warning"
                        Margin="0,0,0,10"
                        IsVisible="{Binding IsWaiting}">
                    <TextBlock x:Name="WaitingText" Text="{Binding WaitingText}" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="AttemptPanel"
                        DockPanel.Dock="Top"
                        Classes="notice plain"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasAttemptText}">
                    <TextBlock x:Name="AttemptText" Text="{Binding AttemptText}" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="KeyNotComparedPanel"
                        DockPanel.Dock="Top"
                        Classes="notice warning"
                        Margin="0,0,0,10"
                        IsVisible="{Binding IsKeyNotCompared}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="KeyNotComparedText" Text="{Binding KeyNotComparedText}" TextWrapping="Wrap" />
                        <Button x:Name="CompareButton"
                                Classes="iconic"
                                c:Icons.Glyph="{StaticResource IconShieldCheck}"
                                HorizontalAlignment="Left"
                                Content="{x:Static res:UiText.ConversationCompare}"
                                Command="{Binding CompareCommand}" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <ProgressBar x:Name="BusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <Border Classes="notice danger" IsVisible="{Binding #ErrorText.IsVisible}">
                        <TextBlock x:Name="ErrorText"
                                   Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <DockPanel>
                        <Button x:Name="SendButton"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Classes="primary iconic"
                                c:Icons.Glyph="{StaticResource IconSend}"
                                Content="{x:Static res:UiText.ConversationSend}"
                                Command="{Binding SendCommand}" />
                        <TextBox x:Name="DraftBox"
                                 Text="{Binding Draft}"
                                 PlaceholderText="{x:Static res:UiText.ConversationMessagePlaceholder}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="160"
                                 AutomationProperties.Name="{x:Static res:UiText.ConversationMessagePlaceholder}"
                                 c:SendOnEnter.Command="{Binding SendCommand}" />
                    </DockPanel>
                </StackPanel>
                <Grid>
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}">
                        <Border Classes="heroIcon">
                            <c:Icon Classes="accent"
                                    Size="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource IconMessage}" />
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Classes="muted centered"
                                   Text="{x:Static res:UiText.ConversationEmpty}"
                                   IsVisible="{Binding IsEmpty}" />
                    </StackPanel>
                    <ScrollViewer c:StickToBottom.IsEnabled="True">
                        <ItemsControl x:Name="MessageItems" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MessageItemViewModel">
                                    <Border Classes="bubble"
                                            Classes.own="{Binding IsOwn}"
                                            Classes.theirs="{Binding IsTheirs}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="caption">
                                                <Run Text="{Binding Sender}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding WrittenAt}" />
                                            </TextBlock>
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="4"
                                                        IsVisible="{Binding IsOwn}">
                                                <TextBlock Classes="caption"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding StateText}" />
                                                <Button Name="DeleteMessageButton"
                                                        Classes="quiet"
                                                        Content="{x:Static res:UiText.CommonDelete}"
                                                        Command="{Binding AskDeleteCommand}"
                                                        IsVisible="{Binding IsDeleteVisible}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <c:Dialog IsOpen="{Binding IsConfirmingDeleteChat}" CancelCommand="{Binding CancelDeleteChatCommand}">
            <Border x:Name="DeleteChatPanel" IsVisible="{Binding IsConfirmingDeleteChat}">
                <StackPanel Spacing="14">
                    <c:DialogHeader Classes="danger"
                                    Glyph="{StaticResource IconTrash}"
                                    Title="{x:Static res:UiText.ConversationDeleteChat}" />
                    <TextBlock x:Name="DeleteChatQuestionText" Text="{Binding DeleteChatQuestion}" TextWrapping="Wrap" />
                    <TextBlock Classes="error"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="DeleteChatBusyBar"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsDeletingChat}"
                                 AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                    <StackPanel Classes="dialogActions">
                        <Button x:Name="DeleteChatCancelButton"
                                Content="{x:Static res:UiText.CommonCancel}"
                                Command="{Binding CancelDeleteChatCommand}" />
                        <Button x:Name="DeleteChatConfirmButton"
                                Classes="danger iconic"
                                c:Icons.Glyph="{StaticResource IconTrash}"
                                Content="{x:Static res:UiText.CommonDelete}"
                                Command="{Binding DeleteChatCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </c:Dialog>

        <c:Dialog IsOpen="{Binding HasDeletingMessage}" CancelCommand="{Binding DeletingMessage.CancelDeleteCommand}">
            <StackPanel x:Name="DeleteMessagePanel"
                        DataContext="{Binding DeletingMessage}"
                        x:DataType="vm:MessageItemViewModel"
                        Spacing="14">
                <c:DialogHeader Classes="danger"
                                Glyph="{StaticResource IconTrash}"
                                Title="{x:Static res:UiText.MessageDelete}" />
                <TextBlock x:Name="DeleteMessageQuestionText"
                           Text="{x:Static res:UiText.MessageDeleteQuestion}"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="DeleteMessageBusyBar"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsDeleting}"
                             AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
                <StackPanel Classes="dialogActions">
                    <Button x:Name="DeleteMessageCancelButton"
                            Content="{x:Static res:UiText.CommonCancel}"
                            Command="{Binding CancelDeleteCommand}" />
                    <Button x:Name="DeleteMessageConfirmButton"
                            Classes="danger iconic"
                            c:Icons.Glyph="{StaticResource IconTrash}"
                            Content="{x:Static res:UiText.CommonDelete}"
                            Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </c:Dialog>
    </Grid>
</UserControl>
