<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             x:Class="P2PMessenger.UI.Views.BackgroundView"
             x:DataType="vm:BackgroundViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <TextBlock x:Name="FirstRunText" Text="{x:Static res:UiText.BackgroundFirstRun}" TextWrapping="Wrap" IsVisible="{Binding IsFirstRun}" />
            <TextBlock x:Name="IntroText" Text="{x:Static res:UiText.BackgroundIntro}" TextWrapping="Wrap" />
            <TextBlock x:Name="BatteryText" Text="{Binding BatteryText}" TextWrapping="Wrap" />
            <Button x:Name="AllowBatteryButton"
                    Content="{x:Static res:UiText.BackgroundBatteryAllow}"
                    Command="{Binding AllowBatteryCommand}"
                    IsVisible="{Binding CanAskBattery}" />
            <Button x:Name="OpenSettingsButton"
                    Content="{x:Static res:UiText.BackgroundOpenSettings}"
                    Command="{Binding OpenSettingsCommand}"
                    IsVisible="{Binding IsRestricted}" />
            <TextBlock x:Name="BatteryRefusedText"
                       Text="{x:Static res:UiText.BackgroundBatteryRefused}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BatteryRefused}" />
            <TextBlock x:Name="NotificationsText" Text="{Binding NotificationsText}" TextWrapping="Wrap" />
            <Button x:Name="AllowNotificationsButton"
                    Content="{x:Static res:UiText.BackgroundNotificationsAllow}"
                    Command="{Binding AllowNotificationsCommand}"
                    IsVisible="{Binding CanAskNotifications}" />
            <CheckBox x:Name="PreviewsBox"
                      Content="{x:Static res:UiText.BackgroundPreviews}"
                      IsChecked="{Binding ShowPreviews}" />
            <TextBlock x:Name="PreviewsHintText" Text="{x:Static res:UiText.BackgroundPreviewsHint}" TextWrapping="Wrap" />
            <Button x:Name="ContinueButton"
                    Content="{x:Static res:UiText.BackgroundContinue}"
                    Command="{Binding ContinueCommand}"
                    IsVisible="{Binding IsFirstRun}" />
            <Button x:Name="QuitOpenButton"
                    Content="{x:Static res:UiText.BackgroundQuit}"
                    Command="{Binding OpenQuitCommand}"
                    IsVisible="{Binding IsQuitOpenVisible}" />
            <Border x:Name="QuitConfirmPanel"
                    Padding="12"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                    IsVisible="{Binding IsConfirmingQuit}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="QuitQuestionText" Text="{x:Static res:UiText.BackgroundQuitQuestion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="QuitWarningText" Text="{x:Static res:UiText.BackgroundQuitWarning}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button x:Name="QuitConfirmButton"
                                Margin="0,0,8,0"
                                Content="{x:Static res:UiText.BackgroundQuitConfirm}"
                                Command="{Binding ConfirmQuitCommand}" />
                        <Button x:Name="QuitCancelButton"
                                Content="{x:Static res:UiText.CommonCancel}"
                                Command="{Binding CancelQuitCommand}" />
                    </WrapPanel>
                    <TextBlock x:Name="QuittingText" Text="{x:Static res:UiText.BackgroundQuitting}" IsVisible="{Binding IsQuitting}" />
                    <TextBlock x:Name="QuitErrorText"
                               Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
