<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             x:Class="P2PMessenger.UI.Views.AddContactView"
             x:DataType="vm:AddContactViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8" MaxWidth="640">
            <TextBlock Text="{x:Static res:UiText.AddContactIntro}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:UiText.AddContactCodeLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="CodeBox"
                     Text="{Binding CodeText}"
                     PlaceholderText="{x:Static res:UiText.AddContactCodePlaceholder}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="96"
                     FontFamily="monospace"
                     AutomationProperties.Name="{x:Static res:UiText.AddContactCodeLabel}" />
            <WrapPanel>
                <Button x:Name="CheckButton" Margin="0,0,8,8" Content="{x:Static res:UiText.AddContactCheck}" Command="{Binding CheckCommand}" />
                <Button x:Name="OpenFileButton" Margin="0,0,8,8" Content="{x:Static res:UiText.AddContactOpenFile}" Command="{Binding OpenFileCommand}" />
            </WrapPanel>
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" />
            <Border x:Name="PreviewPanel"
                    Padding="12"
                    BorderThickness="1"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    IsVisible="{Binding HasPreview}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:UiText.AddContactNameLabel}" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewName" Text="{Binding PreviewName}" FontSize="16" />
                    <TextBlock Text="{x:Static res:UiText.AddContactFingerprintLabel}" FontWeight="SemiBold" />
                    <SelectableTextBlock x:Name="PreviewFingerprint" Text="{Binding PreviewFingerprint}" FontFamily="monospace" />
                    <TextBlock x:Name="PreviewHint" Text="{Binding PreviewHint}" TextWrapping="Wrap" />
                    <Button x:Name="AddButton"
                            Content="{Binding AddText}"
                            Command="{Binding AddCommand}"
                            IsVisible="{Binding CanAddPreview}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
