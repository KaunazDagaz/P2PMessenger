<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:res="using:P2PMessenger.UI.Resources"
             xmlns:v="using:P2PMessenger.UI.Views"
             x:Class="P2PMessenger.UI.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock x:Name="IntroText" Text="{Binding Intro}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:UiText.UnlockPassphraseLabel}" FontWeight="SemiBold" />
            <TextBox x:Name="PassphraseBox"
                     Text="{Binding Passphrase}"
                     PasswordChar="•"
                     AutomationProperties.Name="{x:Static res:UiText.UnlockPassphraseLabel}" />
            <Button x:Name="UnlockButton"
                    Content="{x:Static res:UiText.UnlockUnlock}"
                    Command="{Binding UnlockCommand}"
                    IsDefault="True" />
            <TextBlock x:Name="BusyText" Text="{x:Static res:UiText.UnlockChecking}" IsVisible="{Binding IsBusy}" />
            <ProgressBar x:Name="BusyBar"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
            <TextBlock x:Name="ErrorText"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ForgottenText" Text="{x:Static res:UiText.PassphraseForgotten}" TextWrapping="Wrap" />
            <Panel IsVisible="{Binding OffersDeleteAll}">
                <v:DeleteAllDataPanel x:Name="DeleteAllPanel" DataContext="{Binding DeleteAll}" />
            </Panel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
