<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:P2PMessenger.UI.ViewModels"
             xmlns:s="using:P2PMessenger.UI.Services"
             xmlns:res="using:P2PMessenger.UI.Resources"
             x:Class="P2PMessenger.UI.Views.ContactListView"
             x:DataType="vm:ContactListViewModel">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="AddInPersonButton" Margin="0,0,8,8" Content="{x:Static res:UiText.ContactListAddInPerson}" Command="{Binding AddInPersonCommand}" />
            <Button x:Name="AddContactButton" Margin="0,0,8,8" Content="{x:Static res:UiText.ContactListAddContact}" Command="{Binding AddContactCommand}" />
            <Button x:Name="MyCodeButton" Margin="0,0,8,8" Content="{x:Static res:UiText.ContactListMyCode}" Command="{Binding MyCodeCommand}" />
            <Button x:Name="NewGroupButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListNewGroup}"
                    Command="{Binding NewGroupCommand}"
                    IsVisible="{Binding HasContacts}" />
            <Button x:Name="SendCopyButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListSendCopy}"
                    Command="{Binding SendPcCopyCommand}"
                    IsVisible="{Binding OffersSendPcCopy}" />
            <Button x:Name="ReceiveCopyButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListReceiveCopy}"
                    Command="{Binding ReceivePcCopyCommand}"
                    IsVisible="{Binding OffersReceivePcCopy}" />
            <Button x:Name="PassphraseButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListPassphrase}"
                    Command="{Binding PassphraseCommand}"
                    IsVisible="{Binding OffersPassphrase}" />
            <Button x:Name="BackgroundButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListBackground}"
                    Command="{Binding BackgroundCommand}"
                    IsVisible="{Binding OffersBackground}" />
            <Button x:Name="DeleteAllDataButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListDeleteAllData}"
                    Command="{Binding DeleteAllDataCommand}" />
            <Button x:Name="NetworkButton"
                    Margin="0,0,8,8"
                    Content="{x:Static res:UiText.ContactListNetwork}"
                    Command="{Binding NetworkCommand}"
                    IsVisible="{x:Static s:BuildInfo.IsDebug}" />
        </WrapPanel>
        <Border x:Name="NoNetworkPanel"
                DockPanel.Dock="Top"
                Margin="0,0,0,12"
                Padding="12"
                BorderThickness="1"
                CornerRadius="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                IsVisible="{Binding HasNoNetwork}">
            <TextBlock x:Name="NoNetworkText" Text="{x:Static res:UiText.ContactListNoNetwork}" TextWrapping="Wrap" />
        </Border>
        <DockPanel x:Name="InternetRoutePanel" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="SwitchTorButton"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="{Binding TorSwitchText}"
                    Command="{Binding SwitchTorCommand}"
                    IsVisible="{Binding CanSwitchTor}" />
            <TextBlock x:Name="InternetRouteText"
                       VerticalAlignment="Center"
                       Text="{Binding InternetRouteText}"
                       TextWrapping="Wrap" />
        </DockPanel>
        <ProgressBar x:Name="SwitchTorBusyBar"
                     DockPanel.Dock="Top"
                     Margin="0,0,0,12"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsSwitchingTor}"
                     AutomationProperties.Name="{x:Static res:UiText.CommonWorking}" />
        <TextBlock x:Name="EmptyText"
                   DockPanel.Dock="Top"
                   Text="{x:Static res:UiText.ContactListEmpty}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsEmpty}" />
        <DockPanel x:Name="SearchPanel" DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding HasSearchableItems}">
            <Button x:Name="ClearSearchButton"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Content="{x:Static res:UiText.ContactListSearchClear}"
                    Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearchText}" />
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText}"
                     PlaceholderText="{x:Static res:UiText.ContactListSearchLabel}"
                     AutomationProperties.Name="{x:Static res:UiText.ContactListSearchLabel}" />
        </DockPanel>
        <TextBlock x:Name="NoMatchesText"
                   DockPanel.Dock="Top"
                   Text="{x:Static res:UiText.ContactListNoMatches}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasNoMatches}" />
        <ScrollViewer>
            <StackPanel>
                <TextBlock x:Name="GroupsHeading"
                           Margin="0,0,0,8"
                           Text="{x:Static res:UiText.ContactListGroupsHeading}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HasGroups}" />
                <ItemsControl x:Name="GroupItems" ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:GroupItemViewModel">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding UnreadText}"
                                                   IsVisible="{Binding HasUnread}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding StateText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ContactsHeading"
                           Margin="0,8,0,8"
                           Text="{x:Static res:UiText.ContactListContactsHeading}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding ShowContactsHeading}" />
                <ItemsControl x:Name="ContactItems" ItemsSource="{Binding Contacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ContactItemViewModel">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding UnreadText}"
                                                   IsVisible="{Binding HasUnread}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Fingerprint}" FontFamily="monospace" FontSize="12" />
                                    <TextBlock Text="{Binding StatusText}" />
                                    <TextBlock Text="{Binding KeyText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CopiedChatsHeading"
                           Margin="0,8,0,8"
                           Text="{x:Static res:UiText.ContactListCopiedChatsHeading}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HasCopiedChats}" />
                <ItemsControl x:Name="CopiedChatItems" ItemsSource="{Binding CopiedChats}" IsVisible="{Binding HasCopiedChats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CopiedChatItemViewModel">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    AutomationProperties.Name="{Binding Title}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SummaryText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
