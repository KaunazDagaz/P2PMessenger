<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.flat">
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.notice">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Border.notice.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.notice.success">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <Style Selector="Border.notice.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.notice.danger">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Border.notice.plain">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <Style Selector="Border.notice.plain">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.appbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Border.master">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="ItemsControl.toasts">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="4,4,4,72" />
        <Setter Property="MaxWidth" Value="444" />
    </Style>
    <Style Selector=":is(UserControl).compact ItemsControl.toasts">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,64" />
        <Setter Property="MaxWidth" Value="10000" />
    </Style>
    <Style Selector="Border.toast">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.pill.online">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.pending">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.pill.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.online">
        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.pending">
        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style Selector="Border.bubble">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.bubble.own">
        <Setter Property="Background" Value="{DynamicResource BubbleOwnBrush}" />
        <Setter Property="CornerRadius" Value="18,18,4,18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.bubble.theirs">
        <Setter Property="Background" Value="{DynamicResource BubbleTheirsBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18,18,18,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.bubble.own">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BubbleOwnTextBrush}" />
    </Style>
    <Style Selector="Border.bubble.own TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource BubbleOwnTextBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.bubble.own Button.quiet">
        <Setter Property="Foreground" Value="{DynamicResource BubbleOwnTextBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Border.bubble.own Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource BubbleOwnTextBrush}" />
    </Style>
    <Style Selector="Border.bubble Button.quiet">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.qr">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.fingerprint">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.heroIcon.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>
    <Style Selector="Border.heroIcon.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>

    <Style Selector="Border.iconCircle">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.heroIcon">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="CornerRadius" Value="36" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector=":is(UserControl).compact Border.dialog">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="StackPanel.dialogActions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
    </Style>
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=":is(UserControl).dialogOpen Border.scrim">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="Border.chat">
        <Setter Property="MaxWidth" Value="960" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector=":is(UserControl).compact Border.chat">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="WrapPanel.actions > Button">
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
</Styles>
