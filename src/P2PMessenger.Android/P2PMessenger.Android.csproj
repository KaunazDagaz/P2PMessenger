<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>io.github.kaunazdagaz.p2pmessenger</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <PropertyGroup Label="Tor">
    <TorBundleRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'tor'))</TorBundleRoot>
  </PropertyGroup>

  <ItemGroup Label="Tor">
    <AndroidNativeLibrary Include="$(TorBundleRoot)android-aarch64/tor/libTor.so" Abi="arm64-v8a" Condition="Exists('$(TorBundleRoot)android-aarch64/tor/libTor.so')" />
    <AndroidNativeLibrary Include="$(TorBundleRoot)android-armv7/tor/libTor.so" Abi="armeabi-v7a" Condition="Exists('$(TorBundleRoot)android-armv7/tor/libTor.so')" />
    <AndroidNativeLibrary Include="$(TorBundleRoot)android-x86_64/tor/libTor.so" Abi="x86_64" Condition="Exists('$(TorBundleRoot)android-x86_64/tor/libTor.so')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\P2PMessenger.UI\P2PMessenger.UI.csproj" />
  </ItemGroup>
</Project>
